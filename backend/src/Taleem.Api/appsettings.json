{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=taleem;Username=taleem;Password=taleem"
  },
  "Storage": {
    "RootPath": "storage",
    "MaxUploadBytes": 52428800,
    "AllowedMimeTypes": [ "application/pdf" ],
    "AllowedExtensions": [ ".pdf" ]
  },
  "Chunking": {
    "MaxChunkCharacters": 1200,
    "MinChunkCharacters": 200,
    "OverlapCharacters": 120
  },
  "Embedding": {
    "Provider": "fake",
    "Model": "text-embedding-3-small",
    "Dimensions": 1536
  },
  "AdminAuth": {
    "Username": "admin",
    "Password": "changeme-dev-only",
    "JwtSigningKey": "DEV_ONLY_CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_32+",
    "Issuer": "taleem-admin",
    "Audience": "taleem-admin",
    "TokenLifetimeMinutes": 480
  },
  "CORS_ORIGINS": "http://localhost:3000,http://localhost:3001",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
