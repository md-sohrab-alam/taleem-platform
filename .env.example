# Copy to a local .env (never commit the real file) or set via docker-compose / shell.
# Values below are LOCAL DEVELOPMENT PLACEHOLDERS only — replace for any shared/hosted environment.

# Database (matches local docker-compose defaults)
DATABASE_URL=Host=localhost;Port=5432;Database=taleem;Username=taleem;Password=CHANGE_ME_LOCAL_DB_PASSWORD

# Admin auth (development placeholders — replace before any shared deploy)
AdminAuth__Username=admin
AdminAuth__Password=CHANGE_ME_LOCAL_ADMIN_PASSWORD
AdminAuth__JwtSigningKey=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Embeddings: fake | openai
EMBEDDING_PROVIDER=fake
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Storage (relative path under API working directory)
Storage__RootPath=storage
